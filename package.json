{
  "name": "my-house",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit",
    "android:prepare": "npm run build && npx cap add android && node scripts/install-android-icons.mjs && npx cap sync android",
    "android:sync": "npm run build && npx cap sync android && node scripts/install-android-icons.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "@supabase/supabase-js": "2.119.0",
    "@capacitor/core": "8.0.0",
    "@capacitor/camera": "8.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^5.4.15",
    "@capacitor/cli": "8.0.0",
    "@capacitor/android": "8.0.0",
    "vitest": "^2.1.9"
  }
}
